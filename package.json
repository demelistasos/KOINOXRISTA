{
  "name": "koinoxrista",
  "productName": "Κοινόχρηστα",
  "version": "2.2.0",
  "description": "Υπολογισμός κοινοχρήστων πολυκατοικίας — Windows & macOS",
  "main": "main.js",
  "author": "Tasos Demelis",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/calc.test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tasos.koinoxrista",
    "productName": "Κοινόχρηστα",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": "-",
      "artifactName": "Koinoxrista-Mac-${version}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Koinoxrista-Windows-${version}-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Κοινόχρηστα"
    }
  }
}
